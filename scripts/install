#!/usr/bin/env bash
echo `# <#` >/dev/null
set -euo pipefail

readonly INSTALLER=https://github.com/falcosan/StreamVault/releases/latest/download/StreamVault-install-macos
readonly PLACEHOLDER=/tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress

say() { printf '  %s\n' "$*"; }
die() { printf '\n  %s\n' "$*" >&2; exit 1; }

command_line_tools() {
  xcrun --find cc &>/dev/null && return
  local package
  touch "$PLACEHOLDER"
  package="$(softwareupdate --list 2>/dev/null | grep -o 'Command Line Tools[^*]*' | sort -V | tail -n1 | xargs)" || true
  [[ -n "$package" ]] || { rm -f "$PLACEHOLDER"; die "Command Line Tools package not found"; }
  softwareupdate --install "$package" --agree-to-license &>/dev/null || { rm -f "$PLACEHOLDER"; die "CLT installation failed"; }
  rm -f "$PLACEHOLDER"
}

rust() {
  [[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"
  cargo --version &>/dev/null && return
  say "Installing Rust…"
  export RUSTUP_HOME="$1/rustup" CARGO_HOME="$1/cargo" RUSTUP_INIT_SKIP_PATH_CHECK=yes PATH="$1/cargo/bin:$PATH"
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o "$1/rustup-init.sh" || die "Rust installation failed"
  sh "$1/rustup-init.sh" -y --no-modify-path --profile minimal --default-toolchain stable --quiet </dev/null >/dev/null ||
    die "Rust installation failed"
  cargo --version &>/dev/null || die "cargo not found after setup"
}

[[ "$(uname -s)" == Darwin ]] || die "Run it on macOS, or in PowerShell on Windows."
[[ "${1:-}" == desktop || "${1:-}" == tv ]] || die "Usage: install desktop|tv"
temp="$(mktemp -d)"
trap 'rm -rf "$temp"' EXIT
input=/dev/null
{ : </dev/tty; } 2>/dev/null && input=/dev/tty
if [[ -f "${BASH_SOURCE[0]:-}" ]]; then
  command_line_tools
  rust "$temp"
  say "Building the installer…"
  cargo run --quiet --manifest-path "$(dirname "${BASH_SOURCE[0]}")/../Cargo.toml" --no-default-features --features deploy -- "$1" <"$input"
else
  curl -fsSL "$INSTALLER" -o "$temp/install" || die "Failed to download the StreamVault installer"
  chmod +x "$temp/install"
  "$temp/install" "$1" <"$input"
fi
: <<'#' #> > $null

$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

$device = $args[0]
if ($device -notin 'desktop', 'tv') { throw 'Usage: install desktop|tv' }
$installer = 'https://github.com/falcosan/StreamVault/releases/latest/download/StreamVault-install-windows-x64.exe'
$temp = Join-Path ([IO.Path]::GetTempPath()) "streamvault-$([guid]::NewGuid())"
New-Item -ItemType Directory $temp | Out-Null
try {
  Invoke-WebRequest $installer -OutFile "$temp\install.exe" -UseBasicParsing
  & "$temp\install.exe" $device
  if ($LASTEXITCODE) { throw "The $device install failed." }
} finally {
  Remove-Item $temp -Recurse -Force -ErrorAction SilentlyContinue
}
#
